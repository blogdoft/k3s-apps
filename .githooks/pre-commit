#!/usr/bin/env bash
# Blocks commits that add secrets. Config: .gitleaks.toml; known historical findings: .gitleaks-baseline.json.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

gitleaks_image="ghcr.io/gitleaks/gitleaks:v8.30.1"
args=(git --pre-commit --staged --redact --verbose --no-banner
  --config .gitleaks.toml --baseline-path .gitleaks-baseline.json)

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks "${args[@]}"
elif command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$repo_root:/repo" -w /repo \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
    "$gitleaks_image" "${args[@]}"
else
  echo "Error: neither gitleaks nor docker was found in PATH; install one to commit." >&2
  exit 1
fi
